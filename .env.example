# 复制为 .env 并修改（.env 已在 .gitignore，不会入库）

# 后台解锁密码（必填，首次启动后用它登录后台）
ADMIN_PASSWORD=change-me-local

# 监听端口（Nginx 反代到此端口）
PORT=3001

# 站点名（页面 title 等）
SITE_NAME=Nooj Log

# 部署脚本（scripts/deploy.cjs）使用的服务器连接信息；不配则无法一键部署
# NOOJ_SSH_HOST=2001:db8::1
# NOOJ_SSH_PORT=22
# NOOJ_SSH_USER=ubuntu
# NOOJ_SSH_PASSWORD=change-me

# SQLite 数据库文件目录与本地媒体目录（默认项目下 data/，一般不用改）
# DATA_DIR=./data
# PUBLIC_DIR=./public

# AI 功能（评论 AI 回复 / 英文翻译回退）：留空则自动禁用
# 支持任意 OpenAI 兼容接口（DeepSeek / 通义千问 / 本地 vLLM 等）
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=sk-xxxx
# AI_MODEL=deepseek-chat
